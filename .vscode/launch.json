  "version": "0.2.0",

  "configurations": [
    {
      "name": "Run GgCapturePrint",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/bin/gg_capture_print.dart",
      "args": ["ggCapturePrint", "--param", "value"],
      "console": "debugConsole"
    },
    {
      "name": "Test Current File",
      "type": "dart",
      "request": "launch",
      "program": "${file}"
    }
  ]
}